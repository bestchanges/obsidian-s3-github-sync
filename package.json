{
  "name": "vault-sync",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/git-sync && tsc --noEmit -p packages/obsidian-plugin && tsc --noEmit -p packages/mcp-server",
    "build:plugin": "node packages/obsidian-plugin/esbuild.config.mjs",
    "build:mcp": "node packages/mcp-server/esbuild.config.mjs",
    "bump:plugin": "node scripts/bump-plugin-version.mjs",
    "make-starter": "node scripts/make-starter-vault.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
