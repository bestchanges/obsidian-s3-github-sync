# Shared settings for scripts/backup/*. Copy this to `.env` and fill it in:
#     cp .env.shadow .env
# `.env` is gitignored; `.env.shadow` is the committed template. CLI flags / real env override.
# Design & rationale: ../../BACKUP.md.

# ── S3 source (read-only) ────────────────────────────────────────────────────
BUCKET=                 # vault bucket, e.g. efed-vaults-asia
PREFIX=                 # vault prefix WITH trailing slash, e.g. efed/vaults/work/
AWS_REGION=             # e.g. ap-southeast-1
# Credentials: use a READ-ONLY identity (Get/List only) — never the plugin key. See BACKUP.md §6.2.
# On a laptop, `aws configure` a dedicated read-only profile and export AWS_PROFILE here.
# AWS_PROFILE=vault-backup-ro

# ── restic master secret ─────────────────────────────────────────────────────
# The password that encrypts every repo. LOSE IT = backups unrecoverable (BACKUP.md §6.1).
RESTIC_PASSWORD_FILE=   # e.g. /Users/you/.config/vault-backup/restic-pass  (chmod 600)

# ── Destinations (set the ones you use; DESTS picks which run) ────────────────
DESTS=drive             # comma list: drive,b2,gdrive

# External drive (air-gapped). Local path → skipped cleanly when the drive is unmounted.
DRIVE_REPO=             # e.g. /Volumes/Backup/vault-restic

# Backblaze B2. Use an APPEND-ONLY key for unattended runs; a full key only for --prune (BACKUP.md §6.3).
B2_REPO=                # e.g. b2:yourname-vault-backup:vault-restic
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# Google Drive via rclone (remote must be configured: `rclone config`, remote name 'gdrive').
GDRIVE_REPO=            # e.g. rclone:gdrive:vault-restic

# ── Policy (optional; these are the defaults) ────────────────────────────────
# KEEP_DAILY=14
# KEEP_WEEKLY=8
# KEEP_MONTHLY=12
# KEEP_YEARLY=3
# MAX_AGE_HOURS=36      # staleness alarm on the newest snapshot (0 = off)
