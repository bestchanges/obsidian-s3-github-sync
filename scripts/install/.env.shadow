# Shared settings for scripts/install/*. Copy this to `.env` and fill it in:
#     cp .env.shadow .env
# `.env` is gitignored; `.env.shadow` is the committed template. CLI flags override these.
# Scripts source `.env` automatically, so you set the shared bits once and reuse them.

# ── AWS / S3 leg (scripts 01, 02, 04) ────────────────────────────────────────
VAULT_BUCKET=            # shared S3 bucket name, e.g. efed-vaults-asia
VAULT_REGION=            # AWS region, e.g. ap-southeast-1

# Namespace = your AWS IAM username; used as the top S3 path segment (<user>/vaults/<name>/)
# and in resource names (vault-plugin-<user>, vault-sync-<user>).
# Leave unset to auto-derive from `aws sts get-caller-identity`.
# VAULT_USER=

# ── GitHub leg (script 03 only — OPTIONAL) ───────────────────────────────────
# Skip these for an S3-only vault (no GitHub repo / Actions).
# VAULT_ORG=              # GitHub owner or org for vault repos, e.g. bestchanges
# VAULT_TOOL_REPO=        # the sync tool repo the workflow checks out, e.g. bestchanges/obsidian-s3-github-sync
